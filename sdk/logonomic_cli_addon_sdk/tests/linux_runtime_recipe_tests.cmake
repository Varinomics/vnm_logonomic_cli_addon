cmake_minimum_required(VERSION 3.25)

foreach(required SDK_SOURCE INDEX_TOOL VALIDATE_TOOL TEST_ROOT)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Linux recipe regression requires ${required}.")
    endif()
endforeach()
file(MAKE_DIRECTORY "${TEST_ROOT}/source")
foreach(directory assets capabilities provenance notices)
    file(MAKE_DIRECTORY "${TEST_ROOT}/source/package/${directory}")
endforeach()
file(WRITE "${TEST_ROOT}/source/probe.cpp" [=[
#include <iostream>
int main(int argc, char**) { std::cout << argc << '\n'; return 0; }
]=])
file(WRITE "${TEST_ROOT}/source/manifest.json" [=[
{"bootstrap_version":1,"package_id":"org.example.recipe-probe","release_version":"1.0.0","platforms":["linux-x86_64"],"adapter":{"path":{"linux-x86_64":"adapter/probe"},"argv":[],"environment":{}},"core_protocol_generations":[1],"integrity_index":"package.files.json"}
]=])
set(project [=[
cmake_minimum_required(VERSION 3.25)
project(ordinary_linux_recipe LANGUAGES CXX)
include("@SDK_SOURCE@/cmake/package.cmake")
add_executable(logonomic_cli_addon_index IMPORTED GLOBAL)
set_target_properties(logonomic_cli_addon_index PROPERTIES IMPORTED_LOCATION "@INDEX_TOOL@")
add_executable(probe probe.cpp)
if(RECIPE_UNOWNED_RUNTIME)
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/runtime.cpp" "int recipe_probe_value() { return 1; }\n")
    add_library(recipe_probe_runtime SHARED "${CMAKE_CURRENT_BINARY_DIR}/runtime.cpp")
    target_link_options(probe PRIVATE "LINKER:--no-as-needed")
    target_link_libraries(probe PRIVATE recipe_probe_runtime)
endif()
configure_file(manifest.json generated/logonomic-cli-addon.json COPYONLY)
logonomic_cli_addon_add_package(probe_package org.example.recipe-probe package_directory ADAPTER probe)
]=])
string(CONFIGURE "${project}" project @ONLY)
file(WRITE "${TEST_ROOT}/source/CMakeLists.txt" "${project}")
foreach(mode standalone embedded static static-pie unowned)
    set(build "${TEST_ROOT}/${mode}")
    set(arguments -S "${TEST_ROOT}/source" -B "${build}" -G Ninja -DCMAKE_BUILD_TYPE=Release)
    if(mode STREQUAL "embedded")
        list(APPEND arguments -DLOGONOMIC_CLI_ADDON_EMBEDDED=ON)
    elseif(mode MATCHES "^static")
        list(APPEND arguments "-DCMAKE_EXE_LINKER_FLAGS=-${mode}")
    elseif(mode STREQUAL "unowned")
        list(APPEND arguments -DRECIPE_UNOWNED_RUNTIME=ON)
    endif()
    if(TEST_CXX_COMPILER)
        list(APPEND arguments "-DCMAKE_CXX_COMPILER=${TEST_CXX_COMPILER}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" ${arguments}
        "-DCMAKE_CXX_COMPILER_LAUNCHER=${TEST_CXX_COMPILER_LAUNCHER}" COMMAND_ERROR_IS_FATAL ANY)
    set(package "${build}/package/org.example.recipe-probe")
    if(mode STREQUAL "unowned")
        execute_process(COMMAND "${CMAKE_COMMAND}" --build "${build}" --parallel 1 --target probe_package
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
        set(diagnostic "${output}\n${error}")
        if(result EQUAL 0 OR NOT diagnostic MATCHES "no source-package provenance: [^\n]*librecipe_probe_runtime" OR
           diagnostic MATCHES "Traceback")
            message(FATAL_ERROR "Expected an ownership diagnostic for the linked local runtime: ${diagnostic}")
        endif()
        file(RENAME "${build}/librecipe_probe_runtime.so" "${build}/withheld.so")
        find_package(Python3 3.11 REQUIRED COMPONENTS Interpreter)
        execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${SDK_SOURCE}/cmake/deploy_linux_runtime.py"
            verify --package "${package}" RESULT_VARIABLE result ERROR_VARIABLE error)
        if(result EQUAL 0 OR NOT error MATCHES "Unresolved native dependency: [^\n]*librecipe_probe_runtime" OR
           error MATCHES "Traceback")
            message(FATAL_ERROR "Expected a missing-library diagnostic for the dynamic executable: ${error}")
        endif()
        continue()
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" --build "${build}" --parallel 1 --target probe_package
        COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND "${VALIDATE_TOOL}" "${package}" --platform linux-x86_64
        COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND "${package}/adapter/probe"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0 OR NOT output STREQUAL "1\n")
        message(FATAL_ERROR "Plain Release ${mode} executable did not load: ${result}: ${output}: ${error}")
    endif()
    if(mode MATCHES "^static")
        file(SHA256 "${build}/probe" original)
        file(SHA256 "${package}/adapter/probe" deployed)
        file(READ "${package}/provenance/linux-runtime.json" provenance)
        string(JSON native_members LENGTH "${provenance}" files)
        string(JSON recorded_source GET "${provenance}" files 0 source_sha256)
        string(JSON recorded_final GET "${provenance}" files 0 sha256)
        if(NOT native_members EQUAL 1 OR NOT original STREQUAL deployed OR
           NOT recorded_source STREQUAL original OR NOT recorded_final STREQUAL deployed)
            message(FATAL_ERROR "${mode} package did not preserve its sole linked executable and its provenance")
        endif()
    endif()
endforeach()
