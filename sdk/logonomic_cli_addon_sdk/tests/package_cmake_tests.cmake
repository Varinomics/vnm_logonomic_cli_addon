# Oracle: the package helpers export fresh artifacts with source permissions;
# CMake generator configuration and install-time prefix/DESTDIR own their paths.
foreach(required IN ITEMS PACKAGE_TEST_GENERATOR)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "${required} is required for package CMake fixtures")
    endif()
endforeach()

function(package_fixture_success)
    execute_process(COMMAND ${ARGV}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Package fixture command failed: ${ARGV}\n${output}\n${error}")
    endif()
endfunction()

function(package_fixture_inventory directory out_inventory)
    file(GLOB_RECURSE entries LIST_DIRECTORIES TRUE RELATIVE "${directory}" "${directory}/*")
    list(SORT entries)
    set(inventory "")
    foreach(entry IN LISTS entries)
        if(IS_SYMLINK "${directory}/${entry}")
            file(READ_SYMLINK "${directory}/${entry}" value)
        elseif(IS_DIRECTORY "${directory}/${entry}")
            set(value directory)
        else()
            file(SHA256 "${directory}/${entry}" value)
        endif()
        string(APPEND inventory "${entry}: ${value}\n")
    endforeach()
    set(${out_inventory} "${inventory}" PARENT_SCOPE)
endfunction()

function(package_fixture_refused build prefix destdir reason)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "DESTDIR=${destdir}"
        "${CMAKE_COMMAND}" --install "${build}" --config Release --prefix "${prefix}"
        WORKING_DIRECTORY "${build}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(result EQUAL 0 OR NOT error MATCHES "${reason}")
        message(FATAL_ERROR "Package export did not refuse ${reason}: ${result}\n${output}\n${error}")
    endif()
endfunction()

function(package_fixture_mode name generator make_program)
    set(root "${TEST_ROOT}/package-cmake/${name}")
    set(build "${root}/build")
    set(package_id org.example.export-fixture)
    set(configuration_arguments)
    if(NOT make_program STREQUAL "")
        list(APPEND configuration_arguments "-DCMAKE_MAKE_PROGRAM=${make_program}")
    endif()
    if(name STREQUAL "parent")
        if(NOT "${PACKAGE_TEST_GENERATOR_PLATFORM}" STREQUAL "")
            list(APPEND configuration_arguments -A "${PACKAGE_TEST_GENERATOR_PLATFORM}")
        endif()
        if(NOT "${PACKAGE_TEST_GENERATOR_TOOLSET}" STREQUAL "")
            list(APPEND configuration_arguments -T "${PACKAGE_TEST_GENERATOR_TOOLSET}")
        endif()
    endif()
    package_fixture_success("${CMAKE_COMMAND}" -E env --unset=DESTDIR
        "${CMAKE_COMMAND}" -S "${TEST_ROOT}/package-cmake/source" -B "${build}"
        -G "${generator}" -DCMAKE_BUILD_TYPE=Release
        -DCMAKE_FASTBUILD_CAPTURE_SYSTEM_ENV=OFF ${configuration_arguments})

    file(READ "${build}/multi-config.txt" multi_config)
    file(READ "${build}/package-path-Release.txt" package_directory)
    if(multi_config)
        set(expected "${build}/package/Release/${package_id}")
        file(READ "${build}/package-path-Debug.txt" debug_directory)
        if(NOT debug_directory STREQUAL "${build}/package/Debug/${package_id}")
            message(FATAL_ERROR "Multi-config Debug package directory is incorrect: ${debug_directory}")
        endif()
    else()
        set(expected "${build}/package/${package_id}")
    endif()
    if(NOT package_directory STREQUAL expected)
        message(FATAL_ERROR "Package directory is ${package_directory}; expected ${expected}")
    endif()

    set(prefix "${root}/fresh")
    package_fixture_success("${CMAKE_COMMAND}" -E env --unset=DESTDIR
        "${CMAKE_COMMAND}" --install "${build}" --config Release --prefix "${prefix}")
    file(READ "${prefix}/${package_id}/configuration.txt" installed_configuration)
    if(NOT installed_configuration STREQUAL "Release")
        message(FATAL_ERROR "Export did not select the Release package")
    endif()
    file(SHA256 "${package_directory}/adapter/payload" source_payload)
    file(SHA256 "${prefix}/${package_id}/adapter/payload" installed_payload)
    if(NOT source_payload STREQUAL installed_payload)
        message(FATAL_ERROR "Fresh package export changed payload bytes")
    endif()
    if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
        execute_process(COMMAND stat -c %a "${prefix}/${package_id}/adapter/payload"
            RESULT_VARIABLE result OUTPUT_VARIABLE mode OUTPUT_STRIP_TRAILING_WHITESPACE)
        if(NOT result EQUAL 0 OR NOT mode STREQUAL "750")
            message(FATAL_ERROR "Package export changed source executable mode 750: ${mode}")
        endif()
    endif()

    file(WRITE "${prefix}/${package_id}/sentinel" "existing unrelated package file")
    package_fixture_inventory("${prefix}" before)
    file(WRITE "${package_directory}/configuration.txt" "replacement")
    package_fixture_refused("${build}" "${prefix}" "" "requires an absent destination")
    package_fixture_inventory("${prefix}" after)
    if(NOT before STREQUAL after)
        message(FATAL_ERROR "Refused export altered the existing tree")
    endif()

    set(link_prefix "${root}/symlink")
    file(MAKE_DIRECTORY "${link_prefix}")
    file(CREATE_LINK "${root}/absent" "${link_prefix}/${package_id}" SYMBOLIC RESULT link_result)
    if(link_result STREQUAL "0")
        file(READ_SYMLINK "${link_prefix}/${package_id}" original_target)
        package_fixture_refused("${build}" "${link_prefix}" "" "requires an absent destination")
        if(NOT IS_SYMLINK "${link_prefix}/${package_id}")
            message(FATAL_ERROR "Refused export removed the dangling symlink")
        endif()
        file(READ_SYMLINK "${link_prefix}/${package_id}" target)
        if(NOT target STREQUAL original_target)
            message(FATAL_ERROR "Refused export changed the dangling symlink target")
        endif()
    else()
        message(STATUS "Package dangling-symlink fixture unavailable: ${link_result}")
    endif()

    if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
        set(destdir "${root}/destdir")
        package_fixture_success("${CMAKE_COMMAND}" -E env "DESTDIR=${destdir}/"
            "${CMAKE_COMMAND}" --install "${build}" --config Release --prefix /opt/package-fixture)
        set(staged_package "${destdir}/opt/package-fixture/${package_id}")
        if(NOT EXISTS "${staged_package}/configuration.txt")
            message(FATAL_ERROR "DESTDIR export did not use the POSIX install-prefix mapping")
        endif()
        package_fixture_inventory("${destdir}" before)
        package_fixture_refused("${build}" /opt/package-fixture "${destdir}/"
            "requires an absent destination")
        package_fixture_inventory("${destdir}" after)
        if(NOT before STREQUAL after)
            message(FATAL_ERROR "Refused DESTDIR export altered the existing tree")
        endif()
    endif()

    set(drive_destdir "${root}/drive-destdir")
    file(MAKE_DIRECTORY "${drive_destdir}")
    package_fixture_refused("${build}" C:/package-fixture "${drive_destdir}"
        "does not support DESTDIR with a drive-letter install prefix")
    package_fixture_inventory("${drive_destdir}" drive_inventory)
    if(NOT drive_inventory STREQUAL "")
        message(FATAL_ERROR "Refused drive-prefix export wrote into DESTDIR")
    endif()
    set(package_fixture_parent_multi_config "${multi_config}" PARENT_SCOPE)
endfunction()

set(package_fixture_source "${TEST_ROOT}/package-cmake/source")
file(MAKE_DIRECTORY "${package_fixture_source}")
file(WRITE "${package_fixture_source}/payload" "#!/bin/sh\nexit 0\n")
file(CHMOD "${package_fixture_source}/payload"
    PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE)
set(package_fixture_helper "${CMAKE_CURRENT_LIST_DIR}/../cmake/package.cmake")
set(package_fixture_project [=[
cmake_minimum_required(VERSION 3.21)
project(package_export_fixture LANGUAGES NONE)
include("@package_fixture_helper@")
logonomic_cli_addon_package_directory(org.example.export-fixture package_directory)
get_property(multi_config GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)
file(WRITE "${CMAKE_BINARY_DIR}/multi-config.txt" "${multi_config}")
file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/package-path-$<CONFIG>.txt" CONTENT "${package_directory}")
file(GENERATE OUTPUT "${package_directory}/configuration.txt" CONTENT "$<CONFIG>")
file(GENERATE OUTPUT "${package_directory}/adapter/payload" INPUT "${CMAKE_CURRENT_SOURCE_DIR}/payload"
    USE_SOURCE_PERMISSIONS)
logonomic_cli_addon_install_package("${package_directory}" org.example.export-fixture)
]=])
string(CONFIGURE "${package_fixture_project}" package_fixture_project @ONLY)
file(WRITE "${package_fixture_source}/CMakeLists.txt" "${package_fixture_project}")
package_fixture_mode(parent "${PACKAGE_TEST_GENERATOR}" "${PACKAGE_TEST_MAKE_PROGRAM}")

get_filename_component(package_fixture_make_directory "${PACKAGE_TEST_MAKE_PROGRAM}" DIRECTORY)
find_program(package_fixture_ninja NAMES ninja ninja-build HINTS "${package_fixture_make_directory}")
if(package_fixture_ninja)
    if(package_fixture_parent_multi_config)
        package_fixture_mode(alternate Ninja "${package_fixture_ninja}")
    else()
        package_fixture_mode(alternate "Ninja Multi-Config" "${package_fixture_ninja}")
    endif()
else()
    message(STATUS
        "Opposite generator-mode package fixture unavailable: Ninja was not found. "
        "Single- and multi-config qualification both remain required.")
endif()
