cmake_minimum_required(VERSION 3.21)
foreach(required IN ITEMS INDEX_TOOL VALIDATE_TOOL SIMULATOR_TOOL CONFORMANCE_TOOL FIXTURE_PACKAGES SCRIPT_DIRECTORY TEST_ROOT)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()

# On Windows, run under a non-UTF-8 system ACP as well as under UTF-8.
# No chcp command changes the CRT's argv encoding contract.
set(root "${TEST_ROOT}/naïve-日本 Ω")
file(REMOVE_RECURSE "${TEST_ROOT}")
file(MAKE_DIRECTORY "${root}")
set(package "${root}/package λ")
file(COPY "${FIXTURE_PACKAGES}/org.example.unknown-fixture/" DESTINATION "${package}")
configure_file("${SCRIPT_DIRECTORY}/acknowledge.json" "${root}/操作.json" COPYONLY)

function(require_success)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Unicode-path owner failed (${status}): ${ARGV}\n${output}\n${error}")
    endif()
endfunction()
require_success("${INDEX_TOOL}" "${package}")
require_success("${VALIDATE_TOOL}" "${package}")
require_success("${SIMULATOR_TOOL}" "${package}" --script "${root}/操作.json" --transcript "${root}/結果.jsonl")
if(NOT EXISTS "${root}/結果.jsonl")
    message(FATAL_ERROR "Simulator did not write the exact Unicode transcript path")
endif()
file(SIZE "${root}/結果.jsonl" transcript_size)
if(transcript_size EQUAL 0)
    message(FATAL_ERROR "Simulator wrote an empty transcript")
endif()
require_success("${CONFORMANCE_TOOL}" "${package}")
message(STATUS "All four tools completed against exact Unicode paths")
